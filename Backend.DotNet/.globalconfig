is_global = true

# Security rules enforced as build errors (SQL injection, weak crypto, path traversal, etc.)
dotnet_diagnostic.CA2100.severity = error
dotnet_diagnostic.CA3001.severity = error
dotnet_diagnostic.CA3002.severity = error
dotnet_diagnostic.CA3003.severity = error
dotnet_diagnostic.CA3004.severity = error
dotnet_diagnostic.CA3006.severity = error
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5351.severity = error

# Domain modeling relaxations for clean DDD naming and enum conventions
dotnet_diagnostic.CA1716.severity = none # Identifiers should not match keywords (e.g. Error, Date)
dotnet_diagnostic.CA1724.severity = none # Type names should not match namespaces (e.g. Money)
dotnet_diagnostic.CA1030.severity = none # Use events where appropriate (e.g. RaiseDomainEvent)
dotnet_diagnostic.CA1008.severity = none # Enums should have zero value (allows 1-based database enums)
dotnet_diagnostic.CA1040.severity = none # Avoid empty interfaces (standard CQRS/Mediator marker interfaces)
dotnet_diagnostic.CA1515.severity = none # Consider making public types internal in applications
dotnet_diagnostic.CA2007.severity = none # Do not directly await a Task without ConfigureAwait (not required in ASP.NET Core)
dotnet_diagnostic.CA1848.severity = none # Use LoggerMessage delegates for logging
dotnet_diagnostic.CA5398.severity = none # Avoid hardcoding SslProtocols (explicit TLS 1.2 / 1.3 hardening)
dotnet_diagnostic.CA1303.severity = none # Do not pass literals as localized parameters


