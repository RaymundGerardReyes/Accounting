# ==============================================================================
# R.G.E ACCOUNTING FIRM INC. - ROOT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Canonical Paths:
#   - Root Active Configuration:   E:\Accounting\.env
#   - Root Committed Template:     E:\Accounting\.env.example
#
# Note: Subdirectory .env files (Backend/.env, Frontend/.env.local) are DEPRECATED.
# Both FastAPI Backend and Next.js Frontend read and coordinate exclusively
# through this single authoritative root .env configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL & SQLite Resilient Architecture)
# ------------------------------------------------------------------------------
# If running local PostgreSQL:
#   DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/accounting_db"
# If running on Heroku / Cloud PaaS:
#   DATABASE_URL is automatically populated by Heroku Postgres add-on.
# If PostgreSQL is offline or unconfigured, backend automatically falls back to:
#   sqlite:///./accounting_payments.db with zero downtime.
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/accounting_db"
PGSSLMODE="disable"

# ------------------------------------------------------------------------------
# 2. APPLICATION DOMAINS & NETWORKING
# ------------------------------------------------------------------------------
# Production custom domain or Heroku default application URL
NEXT_PUBLIC_APP_DOMAIN="https://rge-accounting-3aa707d5f496.herokuapp.com"
NEXT_PUBLIC_APP_URL="https://rge-accounting-3aa707d5f496.herokuapp.com"
NEXT_PUBLIC_API_BASE_URL="/api"

# Internal Backend Target for Next.js API Proxy (/api/[...path])
BACKEND_INTERNAL_URL="http://127.0.0.1:5000"
BACKEND_API_URL="http://127.0.0.1:5000"
FRONTEND_ORIGIN="https://rge-accounting-3aa707d5f496.herokuapp.com"

# ------------------------------------------------------------------------------
# 3. ENTERPRISE AUTHENTICATION & SINGLE SIGN-ON (OAuth 2.0 PKCE)
# ------------------------------------------------------------------------------
# Leave empty for built-in local PKCE Handshake simulation with instant corporate self-provisioning.
# Provide client ID & secret to connect live enterprise Identity Providers:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. PAYMONGO PAYMENT GATEWAY (Hosted Checkout, QR Ph, GCash, Maya, Cards)
# ------------------------------------------------------------------------------
# Provide live or test PayMongo API keys from dashboard.paymongo.com:
# Omit or leave empty to automatically run the interactive Local Sandbox Simulator.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 5. GOOGLE FORMS & APPS SCRIPT MIDDLEWARE INTEGRATION
# ------------------------------------------------------------------------------
# Shared secret for authenticating automated submissions from Google Apps Script.
# Apps Script must send header: X-Google-Forms-Secret: <GOOGLE_FORMS_SECRET>
GOOGLE_FORMS_SECRET="rge_gforms_live_sec_89f3a21"
# Optional: Paste deployed Google Apps Script Web App URL here for reverse Sheet sync (doPost)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=""
# Optional: Google Apps Script Web App URL for real-time reverse webhook status sync
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 6. GOOGLE EMAIL SMTP (Digital Receipts & Disbursement Notifications)
# ------------------------------------------------------------------------------
# Generate a 16-character Google App Password under Google Account -> Security -> 2-Step Verification:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="raymundgerardrestaca@gmail.com"
SMTP_APP_PASSWORD=""
SMTP_SENDER_NAME="R.G.E Accounting Firm Inc."
SMTP_USE_TLS="true"
DEFAULT_RECEIPT_EMAIL="raymundgerardrestaca@gmail.com"

# ------------------------------------------------------------------------------
# 7. FINANCE OPERATIONS & CPA GOVERNANCE CONTROLS
# ------------------------------------------------------------------------------
FINANCE_AUTH_MODE="dev"
FINANCE_SEED="dev"
