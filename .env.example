# ==============================================================================
# ACME COST ACCOUNTING & LIVE PAYMENT ORCHESTRATION - ROOT CONFIGURATION
# ==============================================================================
# Canonical Paths:
#   - Root Active Configuration:   E:\Accounting\.env
#   - Root Committed Template:     E:\Accounting\.env.example
#
# Note: Subdirectory .env files (Backend/.env, Frontend/.env.local) are DEPRECATED.
# Both FastAPI Backend and Next.js Frontend read and coordinate exclusively
# through this single authoritative root .env configuration.
#
# Architecture & Security Guidelines:
# 1. Monorepo Integration: This root .env is the single authoritative environment file
#    shared between FastAPI Backend (port 5000) and Next.js 15 Frontend (port 3000).
# 2. Server Secrets Protection: Variables like PAYMONGO_SECRET_KEY and SMTP_APP_PASSWORD
#    are private server credentials. NEVER prefix them with NEXT_PUBLIC_!
# 3. Local Sandbox Simulator Fallback: If PayMongo keys are left empty, the platform
#    runs in Local Sandbox Simulator mode (no real charges, full simulated state flow).
# 4. Version Control: .env is ignored by git. This .env.example is committed as a reference.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PAYMONGO PAYMENT GATEWAY (Hosted Checkout, QR Ph, GCash, Maya, Cards)
# ------------------------------------------------------------------------------
# Dashboard -> Developers -> API Keys.
# Omit or leave blank to enable the local sandbox simulator automatically.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. GOOGLE EMAIL SMTP SETTINGS (Payment Receipts & Cash Advance Dispatches)
# ------------------------------------------------------------------------------
# For Gmail, generate a 16-character Google App Password (requires 2-Step Verification):
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_SENDER_NAME=Acme Accounting & Treasury
SMTP_USE_TLS=true
DEFAULT_RECEIPT_EMAIL=billing@acme.com

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SQLAlchemy Connection URL)
# ------------------------------------------------------------------------------
# Leave empty for local SQLite: sqlite:///./accounting_payments.db
# For PostgreSQL: postgresql+psycopg2://<user>:<password>@localhost:5432/accounting_db
DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. FINANCE OPERATIONS & CPA GOVERNANCE CONTROLS
# ------------------------------------------------------------------------------
# FINANCE_AUTH_MODE:
#   - dev  : Enables developer role switching via X-Act-As-User-Id header
#   - prod : Strictly forbids identity switching and requires signed tokens
# FINANCE_SEED:
#   - dev  : Auto-seeds sample vendors, cash advances, and expense reports on startup
#   - prod : Clean ledger initialization without demo fixtures
FINANCE_AUTH_MODE=dev
FINANCE_SEED=dev

# ------------------------------------------------------------------------------
# 5. FRONTEND & API GATEWAY PROXY CONFIGURATION
# ------------------------------------------------------------------------------
# BACKEND_INTERNAL_URL: Target URL used by Next.js route handlers (/api/[...path])
# to proxy browser calls to FastAPI backend on port 5000.
BACKEND_INTERNAL_URL=http://localhost:5000

# NEXT_PUBLIC_APP_URL: Canonical browser origin for checkout redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
