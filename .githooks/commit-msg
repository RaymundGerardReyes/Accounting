#!/usr/bin/env sh
# Cross-platform commit-msg hook checking Conventional Commits formatting

msg_file="$1"
msg=$(head -n 1 "$msg_file")

# If local commitlint exists in node_modules, use it
if [ -x "./node_modules/.bin/commitlint" ]; then
  ./node_modules/.bin/commitlint --edit "$msg_file"
  exit $?
elif [ -x "./Frontend/node_modules/.bin/commitlint" ]; then
  ./Frontend/node_modules/.bin/commitlint --edit "$msg_file"
  exit $?
fi

# Fallback regex validation for Conventional Commits: <type>(<scope>): <description>
# Allowed types: feat|fix|chore|docs|test|refactor|style|perf
# Allowed scopes: repo|backend|dotnet|frontend|test|docs|agents|versioning|migration|content-pack
pattern="^(feat|fix|chore|docs|test|refactor|style|perf)\((repo|backend|dotnet|frontend|test|docs|agents|versioning|migration|content-pack)\): .+"

if echo "$msg" | grep -Eq "$pattern"; then
  exit 0
else
  echo "=================================================================" >&2
  echo " [REJECTED] Invalid commit message format." >&2
  echo " Must follow: <type>(<scope>): <description>" >&2
  echo " Got: '$msg'" >&2
  echo " Allowed types: feat, fix, chore, docs, test, refactor, style, perf" >&2
  echo " Allowed scopes: repo, backend, dotnet, frontend, test, docs, agents, versioning, migration, content-pack" >&2
  echo "=================================================================" >&2
  exit 1
fi
